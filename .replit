modules = ["python-3.12", "postgresql-16"]
run = "python sync_api.py"

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "openssh"]

[deployment]
run = ["sh", "-c", "python undefined"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5002
externalPort = 3000

[[ports]]
localPort = 8501
externalPort = 80

[workflows]
